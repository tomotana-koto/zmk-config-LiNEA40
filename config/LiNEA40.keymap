#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <16 18>;
            layers = <0 2 1>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <11 13>;
            layers = <0 2 1>;
        };

        Middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <16 17>;
            layers = <1>;
        };

        left_kakko {
            bindings = <&kp LS(N8)>;
            key-positions = <2 3>;
            layers = <0 1 2>;
        };

        right_kakko {
            bindings = <&kp LS(N9)>;
            key-positions = <3 4>;
            layers = <0 2 1>;
        };

        left_kagi {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <12 13>;
            layers = <0 2 1>;
        };

        right_kagi {
            bindings = <&kp NUHS>;
            key-positions = <13 14>;
            layers = <0 2 1>;
        };

        syounari {
            bindings = <&kp LS(COMMA)>;
            key-positions = <22 23>;
            layers = <0 2 1>;
        };

        dainari {
            bindings = <&kp LS(PERIOD)>;
            key-positions = <23 24>;
            layers = <0 2 1>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        minus_single: minus_single {
            compatible = "zmk,behavior-mod-morph";
            label = "MINUS_SINGLE";
            bindings = <&kp MINUS>, <&kp AMPERSAND>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        slash_double: slash_double {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_DOUBLE";
            bindings = <&kp SLASH>, <&kp AT_SIGN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        period_exclamation: period_exclamation {
            compatible = "zmk,behavior-mod-morph";
            label = "PERIOD_EXCLAMATION";
            bindings = <&kp PERIOD>, <&kp EXCLAMATION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        comma_question: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            bindings = <&kp COMMA>, <&kp QUESTION>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        santen: santenj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp QUESTION &kp T &kp INTERNATIONAL_4>;
            label = "SANTENJ";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W                     &kp E       &kp R  &kp T                      &kp Y           &kp U  &kp I                                &kp O                &kp P
&kp A      &kp S                     &kp D       &kp F  &kp G                      &kp H           &kp J  &kp K                                &kp L                &minus_single
&kp Z      &kp X                     &kp C       &kp V  &kp B                      &kp N           &kp M  &comma_question                      &period_exclamation  &slash_double
&kp LCTRL  &mt LS(LG(S)) LG(PERIOD)  &mt F10 F7  &none  &kp SPACE  &mo 2    &mo 3  &kp LEFT_SHIFT         &mt INTERNATIONAL_4 INTERNATIONAL_5  &kp DELETE           &kp LEFT_ALT
            >;

            sensor-bindings = <&re_kp DOWN_ARROW UP_ARROW>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        number_symbol {
            bindings = <
&none  &kp LEFT_BRACKET  &kp HASH     &kp APOS       &santen                                  &kp LS(MINUS)   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp LS(SEMI)
&none  &kp LS(NUMBER_6)  &kp PERCENT  &kp SEMICOLON  &kp LS(INTERNATIONAL_1)                  &kp PERIOD      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&none  &none             &none        &none          &none                                    &kp N0          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&none  &none             &none        &none          &kp SPACE                &none    &none  &kp LEFT_SHIFT                &kp N0        &kp PERIOD    &kp DOUBLE_QUOTES
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        arrow {
            bindings = <
&kp K_MUTE         &none  &kp ESCAPE  &none      &kp TAB                  &kp HOME  &kp PAGE_DOWN  &kp UP_ARROW    &kp PAGE_UP  &none
&kp C_VOLUME_DOWN  &none  &kp DEL     &none      &none                    &kp END   &kp LEFT       &kp DOWN_ARROW  &kp RIGHT    &none
&kp C_VOLUME_UP    &none  &none       &kp LG(V)  &none                    &none     &none          &none           &none        &none
&kp LG(H)          &none  &none       &none      &none    &none    &none  &none                    &none           &none        &mo 5
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        not_in_use {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        WIRELESS {
            bindings = <
&none  &none  &none  &none  &bt BT_CLR_ALL                  &none         &none         &none         &none         &none
&none  &none  &none  &none  &none                           &none         &none         &none         &none         &none
&none  &none  &none  &none  &none                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
&none  &none  &none  &none  &none           &none    &none  &none                       &none         &none         &none
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
